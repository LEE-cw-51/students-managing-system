# Supabase session pooler (port 6543) + sslmode=require
DATABASE_URL=
# openssl rand -hex 32
AUTH_SECRET=
LMS_PASSWORD=
LMS_TZ=Asia/Seoul

# 월간 보고서 AI 분석 (OpenRouter)
# https://openrouter.ai/keys 에서 발급한 키
AI_API_KEY=
# 비우면 openrouter/free 가 사용 가능한 무료 모델 중 하나를 고릅니다.
# 특정 모델을 고정하려면 OpenRouter 모델 ID를 넣습니다. 예: google/gemma-2-9b-it:free
# AI 비서(채팅)는 도구 호출(tool calling)을 지원하는 모델이 필요합니다(무료 모델은 불안정할 수 있음).
# AGENT_MODEL을 넣으면 AI 비서만 그 모델을 쓰고, 월간 보고서·강의 계획은 AI_MODEL을 그대로 씁니다.
# AGENT_MODEL=
# AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1
# AI_HTTP_REFERER=https://math-power-lms.vercel.app
# AI_APP_NAME=Math Power LMS

