# Supabase session pooler (port 6543) + sslmode=require
DATABASE_URL=
# openssl rand -hex 32
AUTH_SECRET=
# 첫 관리자 계정: 계정이 하나도 없을 때 ADMIN_EMAIL + LMS_PASSWORD로 로그인하면 관리자 계정이 만들어지고
# 기존 데이터(기본 작업공간)의 주인이 됩니다. 그 뒤로는 두 값을 쓰지 않으므로 지워도 됩니다.
# (또는 npm run create-admin -- 이메일 "이름")
ADMIN_EMAIL=
LMS_PASSWORD=
LMS_TZ=Asia/Seoul

# 월간 보고서 AI 분석 (OpenRouter)
# https://openrouter.ai/keys 에서 발급한 키
AI_API_KEY=
# 비우면 openrouter/free 가 사용 가능한 무료 모델 중 하나를 고릅니다.
# 특정 모델을 고정하려면 OpenRouter 모델 ID를 넣습니다. 예: google/gemma-2-9b-it:free
# AI 비서(채팅)는 도구 호출(tool calling)을 지원하는 모델이 필요합니다(무료 모델은 불안정할 수 있음).
# AGENT_MODEL을 넣으면 AI 비서만 그 모델을 쓰고, 월간 보고서·강의 계획은 AI_MODEL을 그대로 씁니다.
# AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1
# AI_HTTP_REFERER=https://math-power-lms.vercel.app
# AI_APP_NAME=Math Power LMS

# AI 비서: Anthropic API 직접 연결 (권장)
# https://console.anthropic.com 에서 발급. 넣으면 AI 비서는 Claude Haiku 5.5(claude-haiku-5-5)를 씁니다.
# 비우면 AI 비서도 위의 OpenRouter 설정(AI_API_KEY, AGENT_MODEL/AI_MODEL)을 씁니다.
ANTHROPIC_API_KEY=
# 다른 Claude 모델을 쓰려면 Anthropic 모델 ID를 넣습니다. 예: claude-sonnet-5-5
# AGENT_MODEL=
# AI 비서는 한 시간에 이 횟수까지만 대화를 처리합니다(AI 비용 상한, 연결 방식과 무관). 비우면 60, 0이면 제한 없음.
# AGENT_RATE_LIMIT_PER_HOUR=60
# Claude 커넥터(/api/mcp)는 한 시간에 이 횟수까지만 도구를 호출할 수 있습니다(조회·변경 모두). 비우면 300, 0이면 제한 없음.
# MCP_RATE_LIMIT_PER_HOUR=300
