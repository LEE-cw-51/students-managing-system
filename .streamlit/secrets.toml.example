# 로컬 개발용 샘플입니다. 이 파일을 복사해 secrets.toml 로 만든 뒤 실제 값을 채우세요.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Streamlit Community Cloud 에서는 대시보드 Secrets 에 동일한 키를 등록하세요.
# 실제 비밀번호·서비스계정 키를 이 예시에 넣지 마세요.

APP_PASSWORD = "여기에_앱_로그인_비밀번호"

# Google Spreadsheet ID (시트 URL의 /d/ 와 /edit 사이 문자열)
SHEET_ID = "여기에_구글_시트_ID"

# Google Cloud 서비스 계정 JSON 내용 전체
# JSON 파일의 각 필드를 아래 키에 그대로 옮겨 적습니다.
# private_key 의 줄바꿈은 \n 으로 유지해도 됩니다.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
